// VIAC Reports - data model
//
// This mirrors the Data_Entry sheet of Vision_In_Action_Reporting_Template.xlsx.
// A Session is one row of that sheet; SessionCount reproduces the key-population x
// sex count matrix as rows rather than columns, so VIAC can add a population
// without a schema change.
//
// ENTERPRISE UPGRADE (Phase 1):
//   - Funder: configurable donor/lens table (viac, mama, whw)
//   - Community: lat/lng for map intelligence
//   - Document: file ingestion provenance + SHA-256 dedup
//   - SrhrClinicalTelemetry: MAMA/WHW clinical outcome tracking
//   - AuditLog: immutable edit history

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OFFICER
  COORDINATOR
  APPROVER
}

enum Sex {
  MALE
  FEMALE
}

enum ReportFormat {
  PDF
  DOCX
  XLSX
}

enum NarrativeStatus {
  DRAFT
  FINAL
}

enum ExtractionStatus {
  PENDING
  REVIEWING
  COMMITTED
  FAILED
}

enum AbortionOutcome {
  NO_LONGER_PREGNANT
  STILL_PREGNANT
  UNKNOWN
  LOST_TO_FOLLOW_UP
}

enum SatisfactionRating {
  VERY_SATISFIED
  SATISFIED
  NEUTRAL
  DISSATISFIED
}

model Organization {
  id             String @id @default(cuid())
  name           String
  shortName      String
  headerImageUrl String
  footerImageUrl String
  brandTokens    Json

  defaultObjectives      String @db.Text
  defaultMethodology     String @db.Text
  defaultLessonsLearnt   String @db.Text
  defaultChallenges      String @db.Text
  defaultRecommendations String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Funder {
  id                 String    @id @default(cuid())
  slug               String    @unique
  name               String
  reportingFrequency String    @default("monthly")
  templateConfig     Json      @default("{}")
  isActive           Boolean   @default(true)
  documents          Document[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(OFFICER)
  designation  String?
  divisionId   String?
  division     Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  sessions          Session[]
  facilitatorOf     SessionFacilitator[]
  narrativePeriods  NarrativePeriod[]
  reports           Report[]
  communitiesAdded  Community[]
  uploadedDocuments Document[]
  auditLogs         AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([divisionId])
}

model Region {
  id        String     @id @default(cuid())
  name      String     @unique
  sortOrder Int        @default(0)
  divisions Division[]
}

model Division {
  id           String        @id @default(cuid())
  name         String
  sortOrder    Int           @default(0)
  regionId     String
  region       Region        @relation(fields: [regionId], references: [id], onDelete: Cascade)
  subdivisions Subdivision[]
  users        User[]

  @@unique([regionId, name])
}

model Subdivision {
  id          String      @id @default(cuid())
  name        String
  sortOrder   Int         @default(0)
  divisionId  String
  division    Division    @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  communities Community[]

  @@unique([divisionId, name])
}

model Community {
  id            String      @id @default(cuid())
  name          String
  sortOrder     Int         @default(0)
  subdivisionId String
  subdivision   Subdivision @relation(fields: [subdivisionId], references: [id], onDelete: Cascade)

  lat Float?
  lng Float?

  isCustom    Boolean  @default(false)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  sessions  Session[]
  createdAt DateTime  @default(now())

  @@unique([subdivisionId, name])
  @@index([name])
}

model Project {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  sessions  Session[]
}

model ThematicArea {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  sessions  Session[]
}

model ActivityType {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  sessions  Session[]
}

model AgeGroup {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  sessions  Session[]
}

model KeyPopulation {
  id                 String         @id @default(cuid())
  name               String         @unique
  shortName          String
  tracksMale         Boolean        @default(true)
  tracksFemale       Boolean        @default(true)
  maleLabel          String         @default("Male")
  femaleLabel        String         @default("Female")
  exportGroupLabel   String
  exportMaleHeader   String?
  exportFemaleHeader String?
  sortOrder          Int            @default(0)
  isActive           Boolean        @default(true)
  counts             SessionCount[]
}

model Document {
  id               String           @id @default(cuid())
  fileName         String
  storagePath      String
  fileHash         String           @unique
  mimeType         String
  extractionStatus ExtractionStatus @default(PENDING)
  extractedData    Json?
  funderId         String?
  funder           Funder?          @relation(fields: [funderId], references: [id], onDelete: SetNull)
  uploadedById     String
  uploadedBy       User             @relation(fields: [uploadedById], references: [id])
  sessions         Session[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([fileHash])
  @@index([extractionStatus])
  @@index([uploadedById])
}

model Session {
  id                String        @id @default(cuid())
  date              DateTime      @db.Date
  communityId       String
  community         Community     @relation(fields: [communityId], references: [id])
  projectId         String?
  project           Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  thematicAreaId    String?
  thematicArea      ThematicArea? @relation(fields: [thematicAreaId], references: [id], onDelete: SetNull)
  ageGroupId        String?
  ageGroup          AgeGroup?     @relation(fields: [ageGroupId], references: [id], onDelete: SetNull)
  activityTypeId    String?
  activityType      ActivityType? @relation(fields: [activityTypeId], references: [id], onDelete: SetNull)
  notes             String?       @db.Text
  totalParticipants Int           @default(0)
  sourceDocumentId  String?
  sourceDocument    Document?     @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  createdById       String
  createdBy         User          @relation(fields: [createdById], references: [id])

  facilitators    SessionFacilitator[]
  counts          SessionCount[]
  clinicalRecords SrhrClinicalTelemetry[]
  auditLogs       AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([communityId])
  @@index([projectId])
  @@index([thematicAreaId])
  @@index([createdById])
  @@index([sourceDocumentId])
}

model SessionFacilitator {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
}

model SessionCount {
  id              String        @id @default(cuid())
  sessionId       String
  session         Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  keyPopulationId String
  keyPopulation   KeyPopulation @relation(fields: [keyPopulationId], references: [id], onDelete: Cascade)
  sex             Sex
  count           Int           @default(0)

  @@unique([sessionId, keyPopulationId, sex])
  @@index([keyPopulationId])
}

model SrhrClinicalTelemetry {
  id                          String              @id @default(cuid())
  sessionId                   String
  session                     Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  gestationalAgeWeeks         Int?
  outcomeReported             AbortionOutcome?
  outcomeConfirmationMethods  String[]
  additionalMedicalCareSought Boolean?
  additionalCareType          String?
  additionalCareReason        String?
  satisfactionRating          SatisfactionRating?
  paseScore                   Int?
  autonomousDecisionMade      Boolean?
  gbvDisclosed                Boolean?
  gbvReferralCompleted        Boolean?
  isTelecounseling            Boolean             @default(false)
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  @@index([sessionId])
}

model NarrativePeriod {
  id                  String          @id @default(cuid())
  scopeKey            String          @unique
  scope               Json
  title               String
  periodStart         DateTime        @db.Date
  periodEnd           DateTime        @db.Date
  objectives          String          @db.Text
  methodology         String          @db.Text
  lessonsLearnt       String          @db.Text
  challenges          String          @db.Text
  recommendations     String          @db.Text
  preparedBy          String?
  preparedDesignation String?
  approvedBy          String?
  approvedDesignation String?
  status              NarrativeStatus @default(DRAFT)
  createdById         String
  createdBy           User            @relation(fields: [createdById], references: [id])
  reports             Report[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([periodStart])
}

model Report {
  id                String           @id @default(cuid())
  scope             Json
  title             String
  narrativePeriodId String?
  narrativePeriod   NarrativePeriod? @relation(fields: [narrativePeriodId], references: [id], onDelete: SetNull)
  format            ReportFormat
  fileName          String
  fileUrl           String?
  generatedAt       DateTime         @default(now())
  generatedById     String
  generatedBy       User             @relation(fields: [generatedById], references: [id])

  @@index([generatedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  field      String
  oldValue   String?  @db.Text
  newValue   String?  @db.Text
  reason     String?  @db.Text
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId  String?
  session    Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
}